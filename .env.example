# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key

# Optional OpenRouter routing and app-attribution headers.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://localhost:3000

# Gemini through OpenRouter
RAGOLX_CHAT_MODEL=google/gemini-2.5-flash
RAGOLX_EMBEDDING_MODEL=google/gemini-embedding-001
RAGOLX_EMBEDDING_DIMENSIONS=1536
RAGOLX_EMBEDDING_BATCH_SIZE=32

# Retrieval and reranking
RAGOLX_TOP_K=5
RAGOLX_CANDIDATE_K=50
RAGOLX_TEMPERATURE=0.0
RAGOLX_RERANK_ENABLED=true
# Multilingual option: BAAI/bge-reranker-v2-m3-int8
RAGOLX_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Optional stages
RAGOLX_USE_HYDE=false
RAGOLX_GENERATE_ANSWER=true

# Chroma persistence
RAGOLX_CHROMA_PATH=chroma_db
RAGOLX_CHROMA_COLLECTION=listings

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# UniOLX local backend
UNIOLX_DATABASE_PATH=data/uniolx.db
UNIOLX_JWT_SECRET=replace-with-a-long-random-secret
UNIOLX_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RAGOLX_DATA_PATH=data/listings.json
