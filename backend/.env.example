# .env.example
# ============
# Copy this file to .env and fill in your real values.
# The .env file is listed in .gitignore and will NEVER be committed to git.
#
# How to get these values for Supabase:
#   DATABASE_URL  -> Supabase Dashboard > Project Settings > Database
#                    > Connection string > URI (choose "Transaction" mode)
#   SECRET_KEY    -> Run: python -c "import secrets; print(secrets.token_hex(32))"

# --- Database (Required) ---
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres

# --- App (Required) ---
SECRET_KEY=

# --- App (Optional — defaults shown) ---
APP_ENV=development

# --- CORS (Optional — defaults to Vite dev server) ---
# Add more origins separated by commas, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173
