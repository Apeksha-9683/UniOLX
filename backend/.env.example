# Copy to .env and fill in. Never commit the real .env.

# Database
DATABASE_URL=postgresql+asyncpg://uniolx:uniolx@localhost:5432/uniolx

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Trade PIN security
PIN_SECRET=change-me-to-another-long-random-string
PIN_TTL_MINUTES=15
PIN_MAX_ATTEMPTS=5

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Email (Resend). Leave blank in development: OTPs are logged and returned as devOtp.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=UniOLX <no-reply@uniolx.app>

# AI (Gemini). Leave blank to fall back to the local keyword parser.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# App
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
UPLOADS_DIR=uploads
MAX_UPLOAD_BYTES=5242880
